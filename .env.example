# LinkHub — Variáveis de Ambiente
# Copie este arquivo como .env e preencha os valores
# NUNCA commite o arquivo .env no git!

# Servidor
NODE_ENV=development
PORT=3000

# Segurança — MUDE EM PRODUÇÃO (gere com: node -e "require('crypto').randomBytes(64).toString('hex')|xargs echo")
SESSION_SECRET=troque-isso-por-uma-string-aleatoria-longa-em-producao-minimo-64-chars

# Admin padrão (apenas para setup inicial, mude após o primeiro login)
ADMIN_SENHA=admin123

# URL do site (para links nos emails)
SITE_URL=http://localhost:3000

# SMTP para envio de emails (opcional — sem isso, emails são logados no console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu@email.com
# SMTP_PASS=sua-senha-de-app
# EMAIL_FROM=LinkHub <noreply@seudominio.com>

# Domínio permitido para CORS (em produção, coloque seu domínio)
# ALLOWED_ORIGIN=https://seusite.com.br
